# Anthropic API キー（オーケストレーション: Claude Fable 5 / 検品: Haiku 4.5）
ANTHROPIC_API_KEY=sk-ant-...

# --- 画像生成バックエンド ---------------------------------------------
# IMAGE_BACKEND: "qwen"（ローカル Qwen-Image-Edit 2511）または "gemini"
# 未指定の場合、QWEN_SERVER_URL があれば qwen、なければ gemini を使います
# IMAGE_BACKEND=qwen

# ローカル Qwen サーバーの URL（tools/qwen_server.py）
# QWEN_SERVER_URL=http://localhost:8000

# Google Gemini API キー（gemini バックエンド使用時のみ必須）
GEMINI_API_KEY=...

# Gemini の画像生成モデル（省略時: gemini-2.5-flash-image）
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# 1シートあたりの生成リトライ上限（省略時: 2）
# MAX_ATTEMPTS=2

# サーバーポート（省略時: 3000）
# PORT=3000
