# Anthropic API キー（オーケストレーション: Claude Fable 5 / 検品: Haiku 4.5）
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini API キー（画像生成に使用）
GEMINI_API_KEY=...

# 画像生成モデル（省略時: gemini-2.5-flash-image）
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# 1シートあたりの生成リトライ上限（省略時: 2）
# MAX_ATTEMPTS=2

# サーバーポート（省略時: 3000）
# PORT=3000
